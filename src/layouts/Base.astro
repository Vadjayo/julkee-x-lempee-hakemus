---
import '../styles/global.css';
import { CONFIG } from '../config';
import { CERTIFICATES } from '../data/content';

const title = 'Sampo Rahja: hakemus Julkee x Lempeelle';
const description =
  'Sampo Rahjan hakemus Julkee x Lempeen oman median asiantuntijaksi. Tuotantoon viedyt asiakassivustot, omat tuotteet ja agentit yhdellä sivulla.';
const canonical = new URL('/', Astro.site).href;

// Rakenteinen data: sivu on ProfilePage, jonka pääkohde on Person. Molemmat ovat graafin
// ylätasolla, jotta sekä hakukoneet että yksinkertaiset tarkistimet löytävät Person-merkinnän.
const personId = `${canonical}#sampo-rahja`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: CONFIG.name,
      givenName: 'Sampo',
      familyName: 'Rahja',
      url: canonical,
      mainEntityOfPage: { '@id': `${canonical}#sivu` },
      email: CONFIG.emailHref,
      telephone: CONFIG.phone.replace(/\s/g, ''),
      address: { '@type': 'PostalAddress', addressLocality: 'Oulu', addressCountry: 'FI' },
      description: 'Rakentaa verkkosivuja, tekoälyagentteja ja automaatioita ja vie ne tuotantoon.',
      knowsLanguage: 'fi',
      knowsAbout: [
        'Verkkosivut',
        'Tekninen hakukoneoptimointi',
        'Tekoälyagentit',
        'Automaatiot',
        'Claude Code',
        'Astro',
        'Next.js',
        'React',
        'Sanity',
        'Supabase',
        'n8n',
        'Vercel',
      ],
      hasCredential: CERTIFICATES.map((name) => ({
        '@type': 'EducationalOccupationalCredential',
        name,
        credentialCategory: 'certificate',
        recognizedBy: { '@type': 'Organization', name: 'Anthropic' },
      })),
      sameAs: [CONFIG.linkedin, CONFIG.credly, 'https://github.com/Vadjayo'],
    },
    {
      '@type': 'ProfilePage',
      '@id': `${canonical}#sivu`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'fi',
      dateModified: new Date().toISOString(),
      mainEntity: { '@id': personId },
    },
  ],
};
---
<!doctype html>
<html lang="fi" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="fi_FI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="WordPress on räjäytetty. Tilalle tuli Sampo. Sampo Rahja hakee Julkee x Lempeelle" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      // Ajetaan ennen ensimmäistä piirtoa: intro näytetään vain kerran istunnossa eikä koskaan, jos liikettä on rajoitettu.
      (function () {
        var root = document.documentElement;
        root.classList.replace('no-js', 'js');
        var seen = false;
        try {
          seen = sessionStorage.getItem('intro-seen') === '1';
        } catch (e) {}
        if (seen || matchMedia('(prefers-reduced-motion: reduce)').matches) root.classList.add('intro-done');
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
