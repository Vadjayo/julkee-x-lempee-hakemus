---
import { VERSUS } from '../data/content';
---
<section class="section" id="vertailu" aria-labelledby="vertailu-title">
  <div class="wrap">
    <p class="kicker rv"><b>06</b> / Vertailu</p>
    <h2 id="vertailu-title" class="rv">WordPress vastaan Sampo</h2>
    <table class="vs rv">
      <caption class="visually-hidden">WordPressin ja Sampon vertailu</caption>
      <thead>
        <tr><td></td><th scope="col">WordPress</th><th scope="col">Sampo</th></tr>
      </thead>
      <tbody>
        {VERSUS.map((r) => (
          <tr><th scope="row">{r.topic}</th><td class="wp"><s>{r.wp}</s></td><td class="me">{r.me}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .vs { width: 100%; border-collapse: collapse; margin-top: 48px; font-size: 17px; table-layout: fixed; overflow-wrap: break-word; }
  .vs th, .vs td { text-align: left; padding: 16px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .vs thead th { font: 13px var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--dim); font-weight: 400; }
  .vs tbody th { color: var(--dim); font-weight: 400; width: 26%; }
  .wp { color: var(--dim); width: 32%; }
  .wp s { text-decoration-color: var(--red); }
  .me { font-weight: 600; }
  @media (max-width: 640px) {
    .vs { font-size: 14px; hyphens: auto; }
    .vs th, .vs td { padding: 12px 6px; }
  }
</style>
