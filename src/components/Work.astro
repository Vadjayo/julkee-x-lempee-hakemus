---
import { PROJECTS, SMALL_WORKS, JOB_AGENT_MESSAGE } from '../data/content';
import SitePreview from './SitePreview.astro';
import IlonaMock from './IlonaMock.astro';
import TelegramMock from './TelegramMock.astro';
---
<section class="section" id="tyot" aria-labelledby="tyot-title">
  <div class="wrap">
    <h2 id="tyot-title" class="rv">Nämä ovat jo tuotannossa</h2>
    <p class="lead rv">
      Esikatselut on kuvattu oikeilta sivuilta. Klikatkaa, niin pääsette perille. Suunnittelin, toteutin ja julkaisin
      jokaisen yksin, Claude apuna.
    </p>

    <ul class="grid">
      {PROJECTS.map((p) => (
        <li class="rv">
          <article class="card" data-card id={`tyo-${p.slug}`}>
            <div class="card-preview">
              {p.preview.kind === 'site' && (
                <SitePreview name={p.name} host={p.host!} desktop={p.preview.desktop} mobile={p.preview.mobile} video={p.preview.video} />
              )}
              {p.preview.kind === 'ilona' && <IlonaMock />}
              {p.preview.kind === 'telegram' && (
                <TelegramMock
                  bot={p.name}
                  lines={JOB_AGENT_MESSAGE}
                  time="15.34"
                  actions={['Hyväksy', 'Hylkää', 'Kysy']}
                  caption="Aito viesti 15.11.2026, sanasta sanaan"
                />
              )}
            </div>
            <div class="card-body">
              <p class="type">{p.type}</p>
              <h3>
                {p.url ? (
                  <a class="card-link" href={p.url} target="_blank" rel="noopener">
                    {p.name}<span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (avautuu uuteen välilehteen)</span>
                  </a>
                ) : (
                  p.name
                )}
              </h3>
              <p class="desc">{p.description}</p>
              {p.note && <p class="note">{p.note}</p>}
              <dl class="facts">
                <div>
                  <dt>Tekniikat</dt>
                  <dd><ul class="tags">{p.tech.map((t) => <li>{t}</li>)}</ul></dd>
                </div>
              </dl>
            </div>
          </article>
        </li>
      ))}
    </ul>

    <h3 class="sub rv" id="agentit">Agentit, automaatiot ja oma työkalu</h3>
    <ul class="small-grid">
      {SMALL_WORKS.map((w) => (
        <li class="rv">
          <article class="small">
            <p class="type">{w.type}</p>
            <h4>
              {'url' in w && w.url ? (
                <a class="card-link" href={w.url} target="_blank" rel="noopener">
                  {w.name}<span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (avautuu uuteen välilehteen)</span>
                </a>
              ) : (
                w.name
              )}
            </h4>
            <p class="desc">{w.description}</p>
            <ul class="tags">{w.tech.map((t) => <li>{t}</li>)}</ul>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 56px; }
  .grid > li, .small-grid > li { display: flex; min-width: 0; }
  .card, .small {
    position: relative; flex: 1; min-width: 0;
    display: flex; flex-direction: column;
    border: 1px solid var(--line); border-radius: 20px;
    background: var(--card);
    transition: border-color 0.25s;
  }
  .card:has(.card-link):hover, .small:has(.card-link):hover { border-color: var(--fg); }
  .card-preview { padding: 16px 16px 0; }
  .card-body { padding: 20px 24px 24px; display: flex; flex-direction: column; flex: 1; }
  .type { font: 12px var(--mono); color: var(--red); text-transform: uppercase; letter-spacing: 0.08em; }
  .card h3, .small h4 { margin: 8px 0 10px; }
  .card-link { text-decoration: none; }
  .card-link::after { content: ''; position: absolute; inset: 0; border-radius: 20px; }
  .arrow { display: inline-block; margin-left: 8px; font: 0.8em var(--mono); color: var(--dim); transition: transform 0.25s; }
  .card:hover .arrow, .small:hover .arrow { transform: translate(3px, -3px); color: var(--fg); }
  .desc { color: var(--dim); font-size: 15.5px; text-wrap: pretty; }
  .note { margin-top: 12px; font-size: 14.5px; }
  .facts { margin-top: auto; padding-top: 18px; display: grid; gap: 12px; }
  .facts dt { font: 11px var(--mono); color: var(--dim); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 5px; }
  .facts dd { font-size: 14.5px; }
  .sub { margin-top: 72px; font-size: clamp(22px, 3vw, 30px); letter-spacing: -0.02em; }
  .small-grid { display: grid; grid-template-columns: 1fr; gap: 16px; margin-top: 24px; }
  .small { padding: 22px 24px 24px; }
  .small .tags { margin-top: auto; padding-top: 16px; }
  @media (min-width: 900px) {
    .grid { grid-template-columns: 1fr 1fr; }
    /* Ensimmäinen työ on kärkikortti: koko rivin levyinen, esikatselu vasemmalla. */
    .grid > li:first-child { grid-column: 1 / -1; }
    .grid > li:first-child .card { flex-direction: row; }
    .grid > li:first-child .card-preview { flex: 0 0 58%; padding: 16px 0 16px 16px; }
    .grid > li:first-child .card-body { padding: 32px 32px 28px; justify-content: center; }
    .grid > li:first-child .facts { margin-top: 0; }
    .grid > li:first-child h3 { font-size: 30px; }
    .small-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .arrow, .card, .small { transition: none; }
  }
</style>
