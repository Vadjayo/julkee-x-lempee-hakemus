---
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <p class="kicker hero-kicker">
      <button id="dot" class="dot" type="button" aria-label="Punainen piste. Sammuta painamalla."></button>
      <span><b>Hakemus</b> / Oman median asiantuntija</span>
    </p>
    <h1 id="hero-title">
      <span class="line"><span>WordPress on purettu</span></span>
      <span class="line"><span>Tilalle tuli Sampo</span></span>
    </h1>
    <p class="lead hero-fade">
      Moi Lasse ja koko Julkee x Lempee. Olen <strong>Sampo Rahja</strong>. Rakennan verkkosivuja, tekoälyagentteja ja
      automaatioita ja vien ne tuotantoon asti. Haette tekijää, joka saa asiat valmiiksi. Tällä sivulla on näyttö siitä.
    </p>
    <div class="cta hero-fade">
      <a class="btn" href="#tyot">Katso työt</a>
      <a class="btn ghost" href="#yhteys">Ota yhteyttä</a>
    </div>
    <p id="dot-msg" class="dot-msg" role="status"></p>
  </div>
</section>

<style>
  .hero { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding: 96px 0 72px; }
  .hero .wrap { width: 100%; }
  .hero-kicker { display: flex; align-items: center; gap: 4px; margin-left: -14px; }
  .line { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .line > span { display: inline-block; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 40px; }

  /* Piste on 44 px:n kosketusalue, jonka keskellä on 12 px:n piste. */
  .dot { position: relative; width: 44px; height: 44px; flex: none; border: 0; padding: 0; background: none; cursor: pointer; }
  .dot::before, .dot::after {
    content: ''; position: absolute; left: 50%; top: 50%;
    width: 12px; height: 12px; margin: -6px 0 0 -6px;
    border-radius: 50%; background: var(--red);
  }
  .dot::after { animation: pulse 1.6s ease-out infinite; }
  .dot.off { cursor: default; }
  .dot.off::before { background: #444; }
  .dot.off::after { display: none; }
  @keyframes pulse {
    from { transform: scale(1); opacity: 0.7; }
    to { transform: scale(3.2); opacity: 0; }
  }
  .dot-msg { font: 13px var(--mono); color: var(--dim); min-height: 20px; margin-top: 20px; }

  /* Sisääntulo intron jälkeen. Jos intro on jo nähty, sisältö on paikallaan heti. */
  :global(.js) .line > span { transition: transform 0.9s var(--ease); }
  :global(.js) .line:nth-child(2) > span { transition-delay: 0.12s; }
  :global(.js) .hero-fade, :global(.js) .hero-kicker { transition: opacity 0.7s 0.4s, transform 0.7s 0.4s var(--ease); }
  :global(.js:not(.intro-done)) .line > span { transform: translateY(110%); }
  :global(.js:not(.intro-done)) .hero-fade, :global(.js:not(.intro-done)) .hero-kicker { opacity: 0; transform: translateY(14px); }

  @media (prefers-reduced-motion: reduce) {
    .dot::after { animation: none; display: none; }
    :global(.js) .line > span, :global(.js) .hero-fade, :global(.js) .hero-kicker { transition: none; }
  }
</style>
