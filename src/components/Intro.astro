---
/**
 * Feikki-WordPress, joka räjäytetään sivun tieltä dynamiitilla.
 * Näkyy vain, kun JavaScript on käytössä, liikettä ei ole rajoitettu
 * ja intro on tässä istunnossa vielä näkemättä (ks. Base.astro).
 */
---
<div class="intro" id="intro" aria-hidden="true">
  <div class="intro-bar"><span>Ohjausnäkymä</span><span>Päivitykset (14)</span><span>Lisäosat (47)</span><span>Kommentit (0)</span></div>
  <p class="intro-notice">14 lisäosaa odottaa päivitystä. Yksi niistä kaataa sivun perjantaina</p>
  <div class="intro-old">
    <p class="intro-title">Sampon hakemus</p>
    <p class="intro-sub">Just another WordPress site</p>
  </div>
  <div class="tnt" id="intro-tnt">
    <i class="fuse" id="intro-fuse"></i>
    <i class="spark" id="intro-spark"></i>
    <span class="sticks"><i></i><i></i><i></i><b class="band"></b><b class="glow" id="intro-glow"></b></span>
  </div>
  <div class="blast" id="intro-blast"></div>
  <div class="flash" id="intro-flash"></div>
</div>
<div class="intro-hud" id="intro-hud">
  <span id="intro-pct" role="status">Purettu 0 %</span>
  <span class="intro-meter"><i id="intro-meter"></i></span>
  <button id="intro-skip" type="button">Ohita purku</button>
</div>

<style>
  .intro, .intro-hud { display: none; }
  :global(.js:not(.intro-done)) .intro { display: flex; }
  :global(.js:not(.intro-done)) .intro-hud { display: flex; }
  :global(.js:not(.intro-done) body) { overflow: hidden; }
  .intro {
    position: fixed; inset: 0; z-index: 50;
    flex-direction: column;
    overflow: hidden;
    background: #f0f0f1; color: #1d2327;
    font-family: Georgia, 'Times New Roman', serif;
    transition: opacity 0.4s;
  }
  .intro.gone { opacity: 0; pointer-events: none; }
  /* Palkki katoaa kerralla. Häivytys jättäisi tekstin hetkeksi liian himmeäksi. */
  :global(.js:not(.intro-done)) .intro-hud.gone { display: none; }
  .intro-bar { background: #1d2327; color: #f0f0f1; font: 13px var(--sans); padding: 8px 16px; display: flex; gap: 18px; flex-wrap: wrap; }
  .intro-notice { background: #fff; border-left: 4px solid #d63638; margin: 16px; padding: 12px 16px; font: 14px var(--sans); box-shadow: 0 1px 1px rgba(0, 0, 0, 0.08); }
  .intro-old { flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 24px 24px 200px; }
  .intro-title { font-size: clamp(34px, 6vw, 64px); line-height: 1.1; }
  .intro-sub { font-size: 18px; color: #50575e; margin-top: 10px; }
  /* Lentävät kirjaimet piirretään pseudoelementtinä, jotta ne ovat pelkkää koristetta myös apuvälineille. */
  .intro :global(.ch) { display: inline-block; white-space: pre; }
  .intro :global(.ch)::before { content: attr(data-t); }

  /* Dynamiittinippu: kolme pötköä, vanne ja sytytyslanka. */
  .tnt { position: absolute; left: 50%; bottom: 96px; width: 84px; margin-left: -42px; opacity: 0; }
  .sticks { position: relative; display: flex; gap: 3px; justify-content: center; }
  .sticks i { width: 24px; height: 84px; border-radius: 5px; background: #d63638; box-shadow: inset -5px 0 0 rgba(0, 0, 0, 0.18), inset 0 6px 0 rgba(255, 255, 255, 0.25); }
  .band { position: absolute; left: 0; right: 0; top: 34px; height: 14px; background: #1d2327; border-radius: 2px; }
  .glow { position: absolute; inset: 0; border-radius: 5px; background: #fff; opacity: 0; }
  .fuse { display: block; width: 3px; height: 30px; margin: 0 auto; background: #1d2327; border-radius: 2px; transform-origin: bottom; }
  .spark { position: absolute; left: 50%; top: -7px; width: 14px; height: 14px; margin-left: -7px; border-radius: 50%; background: #ff2b2b; box-shadow: 0 0 0 4px rgba(255, 43, 43, 0.3); opacity: 0; }
  .blast { position: absolute; left: 50%; bottom: 96px; width: 120px; height: 120px; margin: 0 0 -18px -60px; border-radius: 50%; background: #ff2b2b; opacity: 0; }
  .flash { position: absolute; inset: 0; background: #fff; opacity: 0; pointer-events: none; }

  .intro-hud {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 51;
    justify-content: space-between; align-items: center; gap: 16px;
    padding: 12px 20px;
    background: #000; color: var(--fg);
    font: 14px var(--mono);
  }
  #intro-pct { min-width: 13ch; }
  .intro-meter { flex: 1; height: 4px; background: #222; border-radius: 4px; overflow: hidden; }
  .intro-meter i { display: block; height: 100%; background: var(--red); transform: scaleX(0); transform-origin: left; }
  #intro-skip { background: none; border: 1px solid #555; color: var(--fg); font: 13px var(--mono); min-height: 40px; padding: 6px 14px; border-radius: 999px; cursor: pointer; white-space: nowrap; }
  #intro-skip:hover { border-color: var(--fg); }
</style>
