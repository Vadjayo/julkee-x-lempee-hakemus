---
/**
 * Työnhakuagentin aito Telegram-viesti kuvakaappauksena, muokkaamattomana.
 * Viestin sisältö on kirjoitettu myös tekstivastineeksi, jotta ruudunlukijat
 * ja tekoälyhaut pääsevät siihen käsiksi.
 */
import { Picture } from 'astro:assets';
import screenshot from '../assets/agent/tyonhakuagentti-telegram.png';

const alt = [
  'Kuvakaappaus Telegramista. Työnhakuagentin viesti:',
  '100/100 Oman median asiantuntija, Julkee x Lempee. Deadline: ei tiedossa.',
  'Perustelu. Osuu: Junioritason paikka Helsinkissä, jossa sinulla on vahva osaaminen: Astron ja teknisen SEO:n olet vienyt tuotantoon, ja Claude Codea, Verceliä sekä GitHubia käytät päivittäin. Palkka 3600 euroa on junioritasolle sopiva.',
  'Puuttuu: CRM ja analytiikka ovat vasta opettelussa.',
  'Kannattaako hakea: Kyllä, ehdottomasti. Tämä on erittäin hyvä osuma. Korosta hakemuksessasi omaa SaaS-projektia Ilonaa, maksavaa pilottiasiakasta ja neljää asiakassivustoa näyttöinä. Mainitse Claude Codea ja Verceliä käyttävänä päivittäin, Astron ja teknisen SEO:n tuotantoon viemistä. Valmistaudu muuttoon Helsinkiin oikean työn perässä.',
  'Hyväksy, niin luonnos tulee seuraavan ajon mukana. Linkki: julkeexlempee.fi/tuhoa-wordpress. Kello 15.34. Napit: Hyväksy, Hylkää, Kysy.',
].join(' ');
---
<figure class="shot">
  <div class="phone">
    <Picture
      src={screenshot}
      formats={['avif', 'webp']}
      widths={[320, 480, 724]}
      sizes="(min-width: 900px) 300px, 72vw"
      alt={alt}
      loading="lazy"
      decoding="async"
    />
  </div>
  <figcaption>Aito kuvakaappaus Telegramista 15.11.2026</figcaption>
</figure>

<style>
  .shot { border: 1px solid var(--line); border-radius: 12px; background: #111; padding: 16px 16px 12px; display: grid; justify-items: center; gap: 12px; }
  .phone { width: min(300px, 100%); border: 3px solid #1c1c1c; outline: 1px solid #3a3a3a; border-radius: 22px; overflow: hidden; background: #000; }
  .phone :global(img) { width: 100%; height: auto; }
  figcaption { justify-self: start; font: 11px var(--mono); color: var(--dim); }
</style>
