---
import { PIPELINE } from '../data/content';
import { CONFIG } from '../config';
---
<section class="section" id="tyotapa" aria-labelledby="tyotapa-title">
  <div class="wrap">
    <p class="kicker rv"><b>04</b> / Työtapa</p>
    <h2 id="tyotapa-title" class="rv">Näin sivu syntyy</h2>
    <ol class="pipe" id="pipe">
      <li class="pipe-line" aria-hidden="true"><i></i></li>
      {PIPELINE.map((step, i) => (
        <li class="pipe-step" style={`--i:${i}`}>
          <span class="node" aria-hidden="true"></span>
          <h3>{step.name}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
    <p class="lead rv">
      Tämä sivu syntyi samalla putkella. Commit-historia on julkinen.
      <a class="textlink" href={CONFIG.repo} target="_blank" rel="noopener">Katso repo GitHubissa</a>
    </p>
  </div>
</section>

<style>
  .pipe { position: relative; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 20px; margin-top: 56px; }
  .pipe-line { position: absolute; left: 7px; right: 7px; top: 7px; height: 2px; background: var(--line); }
  .pipe-line i { display: block; width: 100%; height: 100%; background: var(--red); transform-origin: left top; }
  .pipe-step { position: relative; }
  .node { display: block; width: 16px; height: 16px; border-radius: 50%; background: var(--red); margin-bottom: 18px; }
  .pipe-step h3 { font-size: 17px; }
  .pipe-step p { margin-top: 8px; color: var(--dim); font-size: 14.5px; text-wrap: pretty; }

  @media (max-width: 899px) {
    /* Kapealla näytöllä putki kulkee ylhäältä alas. */
    .pipe { grid-template-columns: 1fr; gap: 28px; }
    .pipe-line { left: 7px; right: auto; top: 7px; bottom: 7px; width: 2px; height: auto; }
    .pipe-step { padding-left: 40px; }
    .node { position: absolute; left: 0; top: 2px; margin: 0; }
  }

  /* Eteneminen vierityksen mukaan. Ensisijaisesti CSS:n scroll-driven animations. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .pipe { view-timeline: --pipe block; }
      .pipe-line i { animation: grow-x linear both; animation-timeline: --pipe; animation-range: entry 40% cover 62%; }
      .pipe-step { animation: light linear both; animation-timeline: --pipe; animation-range: entry calc(40% + var(--i) * 14%) entry calc(54% + var(--i) * 14%); }
      @media (max-width: 899px) {
        .pipe-line i { animation-name: grow-y; animation-range: entry 30% cover 70%; }
        .pipe-step { animation-range: cover calc(12% + var(--i) * 9%) cover calc(20% + var(--i) * 9%); }
      }
    }
  }
  /* Varatoteutus: IntersectionObserver lisää luokan .in (ks. scripts/main.ts). */
  @supports not (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(.js) .pipe-line i { transform: scaleX(0); transition: transform 1.8s var(--ease); }
      :global(.js) .pipe-step { opacity: 0.25; transition: opacity 0.5s; transition-delay: calc(var(--i) * 0.28s); }
      :global(.js) .pipe.in .pipe-line i { transform: none; }
      :global(.js) .pipe.in .pipe-step { opacity: 1; }
      @media (max-width: 899px) {
        :global(.js) .pipe-line i { transform: scaleY(0); }
      }
    }
  }
  @keyframes grow-x { from { transform: scaleX(0); } to { transform: none; } }
  @keyframes grow-y { from { transform: scaleY(0); } to { transform: none; } }
  @keyframes light { from { opacity: 0.25; } to { opacity: 1; } }
</style>
