---
interface Props {
  bot: string;
  lines: { text: string; kind?: 'title' | 'meta' | 'score' }[];
  caption: string;
  /** Viestin kellonaika ja agentin toimintonapit, kuten ne Telegramissa näkyvät. */
  time?: string;
  actions?: string[];
}
const { bot, lines, caption, time, actions = [] } = Astro.props;

// Peitetty yrityksen nimi piirretään mustana palkkina. Ruudunlukija kuulee, että nimi on peitetty.
const REDACTED = '[yritys]';
const parts = (text: string) => text.split(REDACTED);
---
<figure class="tg" data-play="once">
  <div class="tg-head" aria-hidden="true">
    <span class="avatar">{bot.charAt(0)}</span>
    <span class="tg-name">{bot}</span>
    <span class="tg-sub">botti</span>
  </div>
  <div class="tg-body">
    <div class="typing" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="msg">
      {lines.map((line, i) => (
        <p class:list={['tl', line.kind]} style={`--i:${i}`}>
          {parts(line.text).map((part, n) => (
            <>
              {n > 0 && <span class="redact" role="img" aria-label="yrityksen nimi peitetty" />}
              {part}
            </>
          ))}
        </p>
      ))}
      {time && <p class="tl time" style={`--i:${lines.length}`}>{time}</p>}
    </div>
    {actions.length > 0 && (
      <p class="tl actions" style={`--i:${lines.length + 1}`} aria-hidden="true">
        {actions.map((action) => <span>{action}</span>)}
      </p>
    )}
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .tg { border: 1px solid var(--line); border-radius: 12px; background: #111; overflow: hidden; }
  .tg-head { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-bottom: 1px solid var(--line); }
  .avatar { width: 24px; height: 24px; border-radius: 50%; background: var(--red); color: #000; display: grid; place-items: center; font: 700 12px var(--sans); }
  .tg-name { font-size: 13px; font-weight: 600; }
  .tg-sub { font: 11px var(--mono); color: var(--dim); }
  .tg-body { padding: 12px; }
  .msg { background: #1c1c1c; border: 1px solid #2c2c2c; border-radius: 4px 14px 14px 14px; padding: 10px 12px; max-width: 94%; font-size: 12.5px; line-height: 1.4; }
  .tl { color: #d6d2c8; }
  .tl.title { font-weight: 700; color: var(--fg); }
  .tl.title:not(:first-child) { margin-top: 8px; }
  .tl:not(.title):not(.meta):not(:first-child), .tl.score { margin-top: 8px; }
  .tl.score + .tl.meta { margin-top: 8px; }
  .tl.meta { font: 11px var(--mono); color: var(--dim); }
  .tl.score { color: var(--fg); font-weight: 600; }
  .redact { display: inline-block; width: 4.2em; height: 0.95em; vertical-align: -0.12em; border-radius: 2px; background: #000; border: 1px solid #3a3a3a; }
  .tl.time { margin-top: 2px; text-align: right; font: 10.5px var(--mono); color: var(--dim); }
  .actions { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 6px; max-width: 94%; margin-top: 6px; }
  .actions span { padding: 7px 4px; text-align: center; border-radius: 8px; background: #1c1c1c; border: 1px solid #2c2c2c; font-size: 12.5px; font-weight: 600; color: var(--fg); }
  figcaption { padding: 0 12px 12px; font: 11px var(--mono); color: var(--dim); }

  .tg-body { position: relative; }
  .typing { display: none; position: absolute; left: 12px; top: 12px; gap: 4px; padding: 10px 12px; background: #1c1c1c; border: 1px solid #2c2c2c; border-radius: 4px 14px 14px 14px; }
  .typing i { width: 6px; height: 6px; border-radius: 50%; background: var(--dim); }

  /* Ensin botti "kirjoittaa", sitten viesti ilmestyy ja rivit tulevat yksi kerrallaan. */
  :global(.js) .typing { display: flex; opacity: 0; }
  :global(.js) .tg:not(.playing) .msg, :global(.js) .tg:not(.playing) .tl { opacity: 0; }
  :global(.js) .tg.playing .typing { animation: typing 1.3s linear both; }
  :global(.js) .tg.playing .typing i { animation: dot 0.9s ease-in-out infinite; }
  :global(.js) .tg.playing .typing i:nth-child(2) { animation-delay: 0.15s; }
  :global(.js) .tg.playing .typing i:nth-child(3) { animation-delay: 0.3s; }
  :global(.js) .tg.playing .msg { animation: msg 0.5s 1.3s var(--ease) both; transform-origin: top left; }
  :global(.js) .tg.playing .tl { animation: line 0.5s var(--ease) both; animation-delay: calc(1.45s + var(--i) * 0.32s); }
  @keyframes typing { 0% { opacity: 0; } 10%, 90% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes dot { 0%, 60%, 100% { transform: none; opacity: 0.5; } 30% { transform: translateY(-4px); opacity: 1; } }
  @keyframes msg { from { opacity: 0; transform: scale(0.94); } to { opacity: 1; transform: none; } }
  @keyframes line { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .typing { display: none; }
    :global(.js) .tg .msg, :global(.js) .tg .tl { opacity: 1 !important; animation: none !important; }
  }
</style>
